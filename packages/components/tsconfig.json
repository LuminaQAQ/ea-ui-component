{
  "extends": "../../internal/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@common/*": ["./src/common/*"],
      "@constants/*": ["./src/constants/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/test"]
}
