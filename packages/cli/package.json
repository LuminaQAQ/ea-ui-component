{
  "name": "@easy-component-ui/cli",
  "version": "0.1.0",
  "private": true,
  "description": "easy-component-ui 组件库工程 CLI",
  "type": "module",
  "bin": {
    "ea": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@types/prompts": "^2.4.9",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3"
  }
}
