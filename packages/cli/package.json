{
  "name": "@easy-component-ui/cli",
  "version": "0.1.0",
  "description": "easy-component-ui 组件库工程 CLI",
  "type": "module",
  "bin": {
    "ea": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --banner:js=\"#!/usr/bin/env node\"",
    "prepublishOnly": "pnpm build",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@types/prompts": "^2.4.9",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "cli",
    "web-components",
    "scaffold",
    "easy-component-ui"
  ],
  "author": "LuminaQAQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuminaQAQ/ea-ui-component.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/LuminaQAQ/ea-ui-component/issues"
  },
  "homepage": "https://luminaqaq.github.io/ea-ui-component/",
  "publishConfig": {
    "access": "public"
  }
}
