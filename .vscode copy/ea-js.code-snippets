  // Place your ea_ui_view 工作区 snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "ea-component.js": {
    "scope": "javascript",
    "prefix": "ea-template",
    "body": [
      "      import Base from '@components/Base.js'",
      "",
      "      import stylesheet from './index.scss?inline';",
      "",
      "      export class Ea$1 extends Base {",
      "      /** @type {HTMLElement} */",
      "      #container;",
      "      /** @type {AbortController} */",
      "      #abortController = new AbortController();",
      "",
      "      static get observedAttributes() {",
      "        return [...super.observedAttributes,];",
      "      }",
      "",
      "          state = this.properties({",
      "              type: {",
      "                  // type: ,",
      "                  default: '',",
      "                  observer: (newVal) => {}",
      "          },",
      "        })",
      "",
      "          /**",
      "           * 获取 classlist 列表",
      "           * @return {string} 属性值",
      "           */",

      "   updateContainerClasslist() {",
      "     const className = this.computedClasslist(\"ea-$2\", {",
      "       // ['--' + this.type]: this.type,",
      "     });",
      "",
      "     this.#container.className = className;",
      "",
      "     return className;",
      "   }",
      "",
      "      constructor() {",
      "        super();",
      "",
      "        this.stylesheet = stylesheet;",
      "",
      "        this.\\$render();",
      "      }",
      "",
      "      \\$render() {",
      "        this.shadowRoot.innerHTML = `",
      "      <div class='ea-$2' part='container'>",
      "        <slot></slot>",
      "      </div>",
      "        `;",
      "",
      "        this.#container = this.shadowRoot.querySelector('.ea-$2');",
      "      }",
      "",
      "      connectedCallback() {",
      "        super.connectedCallback();",

      "    this.#abortController?.abort();",
      "    this.#abortController = new AbortController();",
      "",
      "",
      "      }",
      "",
      "  \\$beforeUnmounted() {",
      "    this.#abortController.abort();",
      "  }",
      "}",
      "",
      "if (!window.customElements.get('ea-$2')) {",
      "      window.customElements.define('ea-$2', Ea$1);",
      "}"
    ],
    "description": "ea-template"
  },
  "ea-getter+setter": {
    "scope": "javascript,typescript",
    "prefix": "ea-getter+setter",
    "body": [
      "    // ------- $0 -------",
      "    // #region",
      "    get $0() {",
      "      return this.#states.$0;",
      "    }",
      "",
      "    set $0(value) {",
      "      this.#states.$0 = value;",
      "    }",
      "    // #endregion",
      "    // ------- end -------"
    ],
    "description": "getter+setter"
  },
  "ea-prop": {
    "scope": "javascript,typescript",
    "prefix": "ea-prop",
    "body": [
      "    // ------- $0 -------",
      "    // #region",
      "    get $0() {",
      "      return this.#props.$0;",
      "    }",
      "",
      "    set $0(value) {",
      "      this.#props.$0 = value;",
      "    }",
      "    // #endregion",
      "    // ------- end -------"
    ],
    "description": "getter+setter"
  }
}
