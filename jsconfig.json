{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@events/*": ["src/events/*"],
      "@components/*": ["src/components/*"],
      "@common/*": ["src/common/*"],
      "@themes/*": ["src/themes/*"],
      "@utils/*": ["src/utils/*"],
      "@decorator/*": ["src/decorator/*"],
      "@types/*": ["src/types/*"],
      "@stores/*": ["src/stores/*"],
      "@core/*": ["src/core/*"]
    }
  },
  "include": ["src"]
}
