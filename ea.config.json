      "packages/components/src/components",
      { "path": "packages/components/src/common", "internal": true }
    ],
    "testDir": "packages/components/src/test",
    "entry": "packages/components/src/components/index.ts"
  },
  "templates": ".vscode/ea-ts.code-snippets",
  "check": {
    "rootTestWhitelist": ["ea-form-associated-base.test.js"],
    "ignore": [
      {
        "name": "ea-anchor",
        "rules": ["missing-test"],
        "reason": "组件开发中（WIP），完成后删除本条"
      },
      {
        "name": "ea-theme-toggle",
        "rules": ["missing-test"],
        "reason": "存量缺口：无测试文件，待补"
      }
    ]
  }
}
